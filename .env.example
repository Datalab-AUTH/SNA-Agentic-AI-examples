# Copy this file to .env and fill in your own values:
#   cp .env.example .env        (Windows: copy .env.example .env)

# Open WebUI server + "/api" (Open WebUI's OpenAI-compatible API lives under /api)
OPENWEBUI_BASE_URL=https://filos.csd.auth.gr/api

# API key: send an email to mcharatz@csd.auth.gr for access if you don't have one yet
OPENWEBUI_API_KEY=sk-your-key-here

# The model to use. See the list with:  python 00_check_connection/check_connection.py
OPENWEBUI_MODEL=datalab-2:latest

# Example 07: the PostgreSQL database started with Docker
DATABASE_URL=postgresql://agent_user:agent_password@localhost:5432/agent_sessions

# Hide the Pydantic AI welcome banner
PYDANTIC_AI_NO_BANNER=1
